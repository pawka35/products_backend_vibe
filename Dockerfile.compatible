# Альтернативный Dockerfile для максимальной совместимости со старыми CPU
# Использует Debian Bullseye (старая версия) с Python 3.10
# Этот образ должен работать даже на очень старых процессорах

FROM debian:bullseye-slim as builder

# Устанавливаем Python 3.10 и зависимости для компиляции
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    gcc \
    g++ \
    libc6-dev \
    libffi-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаем симлинки для python и pip
RUN ln -s /usr/bin/python3.10 /usr/bin/python && \
    ln -s /usr/bin/python3.10 /usr/bin/python3

# Создаем виртуальное окружение
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Обновляем pip и устанавливаем зависимости
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Финальный образ
FROM debian:bullseye-slim

# Устанавливаем только Python runtime и необходимые библиотеки
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-minimal \
    libpython3.10 \
    libffi7 \
    libssl1.1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Создаем симлинки
RUN ln -s /usr/bin/python3.10 /usr/bin/python && \
    ln -s /usr/bin/python3.10 /usr/bin/python3

# Копируем виртуальное окружение из builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Создаем пользователя для безопасности
RUN useradd --create-home --shell /bin/bash app
USER app

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем код приложения
COPY --chown=app:app . .

# Открываем порт
EXPOSE 8000

# Команда запуска
CMD ["python", "main.py"]

