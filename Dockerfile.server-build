# Dockerfile для сборки непосредственно на сервере
# Этот вариант гарантирует совместимость с архитектурой сервера
# Используйте этот файл, если стандартный Dockerfile не работает

FROM debian:bullseye-slim

# Устанавливаем Python и все необходимые зависимости
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3-pip \
    gcc \
    g++ \
    libc6-dev \
    libffi-dev \
    libssl-dev \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Создаем симлинки
RUN ln -s /usr/bin/python3.10 /usr/bin/python && \
    ln -s /usr/bin/python3.10 /usr/bin/python3

# Создаем пользователя для безопасности
RUN useradd --create-home --shell /bin/bash app
USER app

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем код приложения
COPY --chown=app:app . .

# Создаем виртуальное окружение и устанавливаем зависимости
RUN python -m venv /home/app/venv
ENV PATH="/home/app/venv/bin:$PATH"

# Устанавливаем зависимости
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Открываем порт
EXPOSE 8000

# Команда запуска
CMD ["python", "main.py"]

